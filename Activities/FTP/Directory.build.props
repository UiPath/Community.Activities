<Project>
  <!-- Import first the parent targets -->
  <Import Project="../Directory.build.props" />


 
  <PropertyGroup>
    <Product>FTP</Product>
    <Description>UiPath FTP Activities Pack</Description>
    <Authors>UiPath</Authors>
    <Company>UiPath</Company>
    <Copyright>© UiPath</Copyright>
    <VersionBuild>$([System.DateTime]::UtcNow.ToString("yy"))$([System.DateTime]::UtcNow.DayOfYear.ToString("F0"))</VersionBuild>
    <VersionRevision>$([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes.ToString("F0"))</VersionRevision>
    <!-- Each project evaluates the minute on its own, so the extended package may require a core version one build minute
         away from the one that was packed. Set FtpDevRevision (property or environment variable) to one value for a local
         build of both packages, e.g. dotnet build -p:FtpDevRevision=500. CI passes /p:Version and is not affected. -->
    <VersionRevision Condition="'$(FtpDevRevision)' != ''">$(FtpDevRevision)</VersionRevision>
    <VersionPrefix Condition="'$(Configuration)' == 'Release'">4.0.0</VersionPrefix>
    <VersionPrefix Condition="'$(Configuration)' == 'Debug'">4.0.$(VersionBuild)-dev.$(VersionRevision)</VersionPrefix>
    <AssemblyVersion Condition="'$(Configuration)' == 'Debug' and '$(VersionPrefix)' != '' ">4.0.$(VersionBuild).$(VersionRevision)</AssemblyVersion>
    <!--leave empty for ci to replace with pre-release tag-->
    <SolutionDir>$(MSBuildThisFileDirectory)</SolutionDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <IsConfigurationRelease>true</IsConfigurationRelease>
  </PropertyGroup>
</Project>