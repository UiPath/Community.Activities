<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(PortableFramework)</TargetFrameworks>
    <OutputPath>..\..\Output\Activities\FTP\</OutputPath>
    <!--leave empty for ci to replace with prelease tag-->
    <VersionSuffix></VersionSuffix>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">false</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Debug'">true</GeneratePackageOnBuild>
    <PackageOutputPath Condition="'$(Configuration)' == 'Debug'">..\..\Output\Activities\Packages\</PackageOutputPath>
  </PropertyGroup>

  <!--
    The extended package keeps the id of the original FTP package: projects that upgrade UiPath.FTP.Activities keep working
    as before. The activity code comes from the dependency UiPath.FTP.Core.Activities (a project reference below becomes
    a package dependency); the extended assembly only carries a copy of Core's activities manifest and icons, so that
    Studio Web lists the package and shows its activities. It adds the SFTP algorithms that are not provided by the operating
    system crypto module, so it is not limited to OS crypto; new projects that need that use UiPath.FTP.Core.Activities.
  -->
  <PropertyGroup>
    <PackageId>UiPath.FTP.Activities</PackageId>
    <PackageTitle>UiPath.FTP.Activities</PackageTitle>
    <PackageIconUrl>https://download.uipath.com/UI_icon.png?web</PackageIconUrl>
    <PackageLicenseUrl>https://docs.uipath.com/activities/docs/about-the-ftp-activities-pack</PackageLicenseUrl>
    <PackageTags>UiPathActivities</PackageTags>
    <Description>IMPORTANT: This package version requires Studio v24.10 or above. Installing it on versions lower than the recommended ones may cause unexpected changes in your workflows. UiPath FTP Activities Pack. Includes UiPath.FTP.Core.Activities and the additional SFTP algorithms (Ed25519, curve25519, Diffie-Hellman, legacy ciphers and MACs, encrypted OpenSSH keys) that earlier versions offered; not limited to operating system cryptography. Use UiPath.FTP.Core.Activities for operating system cryptography only.</Description>
    <Authors>UiPath</Authors>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);AddDlls</TargetsForTfmSpecificBuildOutput>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
  </PropertyGroup>

  <Target Name="RemoveMetaDll" AfterTargets="BuiltProjectOutputGroup">
    <ItemGroup>
      <BuiltProjectOutputGroupOutput Remove="@(BuiltProjectOutputGroupOutput)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <!-- Docs for tools that read a package's shipped files by the id a project references: the overview of this package
       (it points to the core package) plus the activity and coded API documents of the core package, which apply as is. -->
  <ItemGroup>
    <Content Include="docs\overview.md" Pack="true" PackagePath="content\docs" />
    <Content Include="..\UiPath.FTP.Core.Activities.Packaging\docs\activities\**\*" Pack="true" PackagePath="content\docs\activities" Link="docs\activities\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\UiPath.FTP.Core.Activities.Packaging\docs\coded-api.md" Pack="true" PackagePath="content\docs" Link="docs\coded-api.md" />
  </ItemGroup>

  <Target Name="AddDlls">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)UiPath.FTP.Activities.Extended.dll" />
    </ItemGroup>
  </Target>

  <Target Name="CleanPackageFiles" BeforeTargets="Build">
    <Message Text="Deleting packages ..." />
    <ItemGroup>
      <PackageFilesToDelete Include="$(PackageOutputPath)\$(PackageId).*.nupkg" />
    </ItemGroup>
    <Delete Files="@(PackageFilesToDelete)" ContinueOnError="WarnAndContinue" />
  </Target>

  <ItemGroup Condition=" '$(TargetFramework)' == '$(PortableFramework)' ">
    <!-- The assembly that ships; its content is added by AddDlls, nothing flows from it -->
    <ProjectReference Include="..\UiPath.FTP.Extended\UiPath.FTP.Extended.csproj">
      <PrivateAssets>All</PrivateAssets>
    </ProjectReference>
    <!-- The core package becomes the package dependency UiPath.FTP.Core.Activities -->
    <ProjectReference Include="..\UiPath.FTP.Core.Activities.Packaging\UiPath.FTP.Core.Activities.Packaging.csproj" />
  </ItemGroup>
</Project>
