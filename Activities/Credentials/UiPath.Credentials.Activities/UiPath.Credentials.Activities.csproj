<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop" ToolsVersion="Current">

  <PropertyGroup>
    <TargetFrameworks>$(WindowsFramework)</TargetFrameworks>
    <OutputPath>..\..\Output\Activities\Credentials\</OutputPath>
    <UseWPF>true</UseWPF>
    <PackageId>UiPath.Credentials.Activities.Implementation</PackageId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="UiPath.Telemetry.Client" />
	<PackageReference Include="UiPath.Workflow" />
    <PackageReference Include="System.Activities.Core.Presentation" />
	<PackageReference Include="UiPath.Activities.Contracts" PrivateAssets="All" Version="24.10.1" />
	<PackageReference Include="UiPath.Activities.Api" PrivateAssets="All" />
	<PackageReference Include="UiPath.Platform" />
    <PackageReference Include="CredentialManagement.Standard" Version="1.0.4" />
	<PackageReference Include="System.Activities.ViewModels" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Duplex" Version="4.10.3" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="4.10.3" />
    <PackageReference Include="System.ServiceModel.Federation" Version="4.10.3" />

    <!--Dependencies override to solve FOSSA issues-->
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Formats.Asn1" />
    <PackageReference Include="System.Text.RegularExpressions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\UiPath.Credentials.Activities.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>UiPath.Credentials.Activities.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\UiPath.Credentials.Activities.*.resx">
      <DependentUpon>UiPath.Credentials.Activities.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\UiPath.Credentials.Activities.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>UiPath.Credentials.Activities.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
	<Import Project="..\..\Shared\UiPath.Shared\UiPath.Shared.projitems" Label="Shared" />
	<ItemGroup>
		<InternalsVisibleTo Include="UiPath.FTP.Activities.Design" />
	</ItemGroup>
	<Import Project="..\..\Shared\UiPath.Shared.Telemetry\UiPath.Shared.Telemetry.projitems" Label="Shared" />
	<Import Project="..\..\Shared\UiPath.Shared.Activities\UiPath.Shared.Activities.projitems" Label="Shared" />
	<Import Project="..\..\Shared\UiPath.Shared.Contracts\UiPath.Shared.Contracts.projitems" Label="Shared" />
	<Import Project="..\..\Shared\UiPath.Shared.Contracts.Private\UiPath.Shared.Contracts.Private.projitems" Label="Shared" />
</Project>
