<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(PortableFramework)</TargetFrameworks>
    <OutputPath>..\..\Output\Activities\Cryptography\</OutputPath>
    <!--leave empty for ci to replace with prelease tag-->
    <VersionSuffix></VersionSuffix>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">false</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Debug'">true</GeneratePackageOnBuild>
    <PackageOutputPath Condition="'$(Configuration)' == 'Debug'">..\..\Output\Activities\Packages\</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>UiPath.Cryptography.Core.Activities</PackageId>
    <PackageTitle>UiPath.Cryptography.Core.Activities</PackageTitle>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageIconUrl>https://download.uipath.com/UI_icon.png?web</PackageIconUrl>
    <PackageProjectUrl>https://docs.uipath.com/activities/docs/about-the-cryptography-activities-pack</PackageProjectUrl>
    <PackageTags>UiPathActivities</PackageTags>
    <Description>IMPORTANT: This package version requires Studio v24.10 or above. Installing it on versions lower than the recommended ones may cause unexpected changes in your workflows. UiPath Cryptography Activities Pack (core): operating system cryptography only. PGP needs the extended package UiPath.Cryptography.Activities, which adds the OpenPGP implementation.</Description>
    <Authors>UiPath</Authors>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);AddDlls</TargetsForTfmSpecificBuildOutput>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == '$(PortableFramework)' ">
    <ProjectReference Include="..\..\Cryptography\UiPath.Cryptography.Activities\UiPath.Cryptography.Activities.csproj">
      <PrivateAssets>All</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\..\Cryptography\UiPath.Cryptography.Activities.API\UiPath.Cryptography.Activities.API.csproj">
      <PrivateAssets>All</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == '$(PortableFramework)' ">
    <PackageReference Include="System.Formats.Asn1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Activities.ViewModels" />
    <PackageReference Include="UiPath.Platform" />
    <PackageReference Include="UiPath.Telemetry.Client" />
    <PackageReference Include="UiPath.CodedWorkflows" />
  </ItemGroup>

  <Target Name="RemoveMetaDll" AfterTargets="BuiltProjectOutputGroup">
    <ItemGroup>
      <BuiltProjectOutputGroupOutput Remove="@(BuiltProjectOutputGroupOutput)" />
    </ItemGroup>
  </Target>

  <Target Name="AddDlls">
    <!-- PDBs for debug-->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
      <BuildOutputInPackage Include="$(OutputPath)UiPath.Cryptography.pdb" />
      <BuildOutputInPackage Include="$(OutputPath)UiPath.Cryptography.Activities.pdb" />
    </ItemGroup>
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)UiPath.Cryptography.dll" />
      <BuildOutputInPackage Include="$(OutputPath)UiPath.Cryptography.Activities.dll" />

      <CryptographyResources Include="$(OutputPath)**\UiPath.Cryptography.resources.dll" />
      <BuildOutputInPackage Include="@(CryptographyResources)">
        <TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </BuildOutputInPackage>

      <CryptographyActivitiesResources Include="$(OutputPath)**\UiPath.Cryptography.Activities.resources.dll" />
      <BuildOutputInPackage Include="@(CryptographyActivitiesResources)">
        <TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      </BuildOutputInPackage>
    </ItemGroup>

    <!--Coded workflow API files-->
    <ItemGroup Label="AddCodedWorkflowAPI">
      <BuildOutputInPackage Include="$(OutputPath)UiPath.Cryptography.Activities.API.dll" />
      <BuildOutputInPackage Include="$(OutputPath)UiPath.Cryptography.Activities.API.xml" />
    </ItemGroup>
  </Target>

  <!--Pack .md files-->
  <ItemGroup>
    <Content Include="docs\**\*" Pack="true" PackagePath="content\docs" />
  </ItemGroup>
  
  <!--
    Guard for what the compliance scan judges: this package must not declare PgpCore or BouncyCastle as a dependency, nor
    ship their assemblies. Both belong to the extension package UiPath.Cryptography.Activities.
    The nuspec lists the dependencies and every packed file, so one text check covers both. GenerateNuspec has already
    written the .nupkg when this runs, so a rejected package is deleted before the error is raised; otherwise a pipeline
    that continues after a failed pack step (continueOnError) would still publish it.
  -->
  <Target Name="GuardNoNonOsCrypto" AfterTargets="GenerateNuspec">
    <PropertyGroup>
      <_GuardNuspec>$(NuspecOutputPath)$(PackageId).$(PackageVersion).nuspec</_GuardNuspec>
      <_GuardNuspecText Condition="Exists('$(_GuardNuspec)')">$([System.IO.File]::ReadAllText('$(_GuardNuspec)'))</_GuardNuspecText>
      <_GuardRejected Condition="'$(_GuardNuspecText)' == '' Or $(_GuardNuspecText.Contains('PgpCore')) Or $(_GuardNuspecText.Contains('BouncyCastle'))">true</_GuardRejected>
    </PropertyGroup>
    <ItemGroup Condition="'$(_GuardRejected)' == 'true'">
      <_GuardPackageToDelete Include="$(PackageOutputPath)$(PackageId).$(PackageVersion).nupkg;$(PackageOutputPath)$(PackageId).$(PackageVersion).snupkg" />
    </ItemGroup>
    <Delete Condition="'$(_GuardRejected)' == 'true'" Files="@(_GuardPackageToDelete)" ContinueOnError="WarnAndContinue" />
    <Error Condition="'$(_GuardNuspecText)' == ''" Text="The generated nuspec $(_GuardNuspec) was not found; cannot check the package dependencies." />
    <Error Condition="'$(_GuardRejected)' == 'true' And '$(_GuardNuspecText)' != ''" Text="$(PackageId) must not depend on or ship PgpCore or BouncyCastle (OS crypto only); they belong to UiPath.Cryptography.Activities. The package was deleted." />
  </Target>

  <!--
    Runs right before the new .nupkg is written, not before Build: the extended packaging project references this one, and
    that reference builds it without packing, so a Build-time cleanup would delete this package and never recreate it.
  -->
  <Target Name="CleanPackageFiles" BeforeTargets="GenerateNuspec">
    <Message Text="Deleting packages ..." />
    <ItemGroup>
      <PackageFilesToDelete Include="$(PackageOutputPath)\$(PackageId)*.nupkg" />
    </ItemGroup>
    <Delete Files="@(PackageFilesToDelete)" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>