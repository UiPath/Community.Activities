<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(PortableFramework)</TargetFrameworks>
    <OutputPath>..\..\Output\Activities\Cryptography\</OutputPath>
    <!--leave empty for ci to replace with prelease tag-->
    <VersionSuffix></VersionSuffix>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">false</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Debug'">true</GeneratePackageOnBuild>
    <PackageOutputPath Condition="'$(Configuration)' == 'Debug'">..\..\Output\Activities\Packages\</PackageOutputPath>
  </PropertyGroup>

  <!--
    The extended package keeps the id of the original Cryptography package: projects that upgrade
    UiPath.Cryptography.Activities keep working as before. The activity code comes from the dependency
    UiPath.Cryptography.Core.Activities (a project reference below becomes a package dependency); the extended assembly
    only carries the OpenPGP implementation and a copy of Core's activities manifest and icons, so that Studio Web lists
    the package and shows its activities. OpenPGP has no operating system equivalent (PgpCore on BouncyCastle), so this
    package is not limited to OS crypto; projects that need OS crypto only use UiPath.Cryptography.Core.Activities.
  -->
  <PropertyGroup>
    <PackageId>UiPath.Cryptography.Activities</PackageId>
    <PackageTitle>UiPath.Cryptography.Activities</PackageTitle>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageIconUrl>https://download.uipath.com/UI_icon.png?web</PackageIconUrl>
    <PackageProjectUrl>https://docs.uipath.com/activities/docs/about-the-cryptography-activities-pack</PackageProjectUrl>
    <PackageTags>UiPathActivities</PackageTags>
    <Description>UiPath Cryptography Activities Pack. Includes UiPath.Cryptography.Core.Activities and the OpenPGP implementation (PgpCore, BouncyCastle) that the PGP activities and the PGP option of the encryption activities need; not limited to operating system cryptography. Use UiPath.Cryptography.Core.Activities for operating system cryptography only.</Description>
    <Authors>UiPath</Authors>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);AddDlls</TargetsForTfmSpecificBuildOutput>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="RemoveMetaDll" AfterTargets="BuiltProjectOutputGroup">
    <ItemGroup>
      <BuiltProjectOutputGroupOutput Remove="@(BuiltProjectOutputGroupOutput)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="PgpCore" />
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <Target Name="AddDlls">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)UiPath.Cryptography.Activities.Extended.dll" />
    </ItemGroup>
  </Target>

  <Target Name="CleanPackageFiles" BeforeTargets="Build">
    <Message Text="Deleting packages ..." />
    <ItemGroup>
      <PackageFilesToDelete Include="$(PackageOutputPath)\$(PackageId).*.nupkg" />
    </ItemGroup>
    <Delete Files="@(PackageFilesToDelete)" ContinueOnError="WarnAndContinue" />
  </Target>

  <ItemGroup Condition=" '$(TargetFramework)' == '$(PortableFramework)' ">
    <!-- The assembly that ships; its content is added by AddDlls, nothing flows from it -->
    <ProjectReference Include="..\UiPath.Cryptography.Activities.Extended\UiPath.Cryptography.Activities.Extended.csproj">
      <PrivateAssets>All</PrivateAssets>
    </ProjectReference>
    <!-- The core package becomes the package dependency UiPath.Cryptography.Core.Activities -->
    <ProjectReference Include="..\UiPath.Cryptography.Core.Activities.Packaging\UiPath.Cryptography.Core.Activities.Packaging.csproj" />
  </ItemGroup>
</Project>
