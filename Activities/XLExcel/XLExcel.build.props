<Project>
	<PropertyGroup>
		<Product>XLExcel</Product>
		<Authors>UiPath</Authors>
		<Company>UiPath</Company>
		<Copyright>© UiPath</Copyright>
		<VersionBuild>$([System.DateTime]::UtcNow.DayOfYear.ToString("F0"))</VersionBuild>
		<VersionRevision>$([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes.ToString("F0"))</VersionRevision>
		<VersionPrefix Condition="'$(Configuration)' == 'Release'">1.0.0</VersionPrefix>
		<VersionPrefix Condition="'$(Configuration)' == 'Debug'">1.0.$(VersionBuild)-dev.$(VersionRevision)</VersionPrefix>
		<AssemblyVersion Condition="'$(Configuration)' == 'Debug' and '$(VersionPrefix)' != '' ">1.0.$(VersionBuild).$(VersionRevision)</AssemblyVersion>
		<SolutionDir>$(MSBuildThisFileDirectory)</SolutionDir>
		<DefineConstants>$(DefineConstants);ENABLE_DEFAULT_TELEMETRY</DefineConstants>
    
    <LangVersion>10.0</LangVersion>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);1701;1702;CS0436;CS1591;MSB3270;MSB3836;NU1903;CS1570;</NoWarn>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsTestProject)' != 'true'">
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<IsConfigurationRelease>true</IsConfigurationRelease>
	</PropertyGroup>
</Project>