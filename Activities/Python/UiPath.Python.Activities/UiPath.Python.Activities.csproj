<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="Current">
  <Import Project="..\Python.build.props" />
  <PropertyGroup>
    <PackageId>.noconflict</PackageId>
    <TargetFrameworks>$(PortableFramework)</TargetFrameworks>
    <OutputPath>..\..\Output\Activities\Python\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <!--<PropertyGroup>
    <PreBuildEvent>"$(ProjectDir)..\..\Tools\localization_utilities\dist\synchronize_localization.exe" "$(ProjectDir)\" "$(ProjectName)</PreBuildEvent>
  </PropertyGroup>-->
  <Import Project="..\..\Shared\UiPath.Shared.Activities\UiPath.Shared.Activities.projitems" Label="Shared" />
  <Import Project="..\..\Shared\UiPath.Shared\UiPath.Shared.projitems" Label="Shared" />
	<ItemGroup>
		<PackageReference Include="System.Activities.ViewModels" />
		<PackageReference Include="UiPath.Telemetry.Client" Version="2.6.1" />
		<PackageReference Include="UiPath.Workflow" />
		<PackageReference Include="UiPath.Activities.Contracts" PrivateAssets="All" />
		<PackageReference Include="UiPath.Activities.Api" PrivateAssets="All" />
		<PackageReference Include="UiPath.Platform" />
	</ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\UiPath.Python.Activities.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>UiPath.Python.Activities.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UiPath.Activities.Api" />
    
    <ProjectReference Include="..\UiPath.Python\UiPath.Python.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\UiPath.Python.Activities.*.resx">
      <DependentUpon>UiPath.Python.Activities.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\UiPath.Python.Activities.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>UiPath.Python.Activities.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <Import Project="..\..\Shared\UiPath.Shared.Telemetry\UiPath.Shared.Telemetry.projitems" Label="Shared" />
  <Import Project="..\..\Shared\UiPath.Shared.Activities\UiPath.Shared.Activities.projitems" Label="Shared" />
  <Import Project="..\..\Shared\UiPath.Shared.Contracts\UiPath.Shared.Contracts.projitems" Label="Shared" />
  <Import Project="..\..\Shared\UiPath.Shared.Contracts.Private\UiPath.Shared.Contracts.Private.projitems" Label="Shared" />
</Project>