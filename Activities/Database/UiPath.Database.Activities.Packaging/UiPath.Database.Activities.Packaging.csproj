<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(PortableFramework);$(WindowsFramework)</TargetFrameworks>
        <OutputPath>..\..\Output\Activities\Database\</OutputPath>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <Platforms>AnyCPU;x86;x64</Platforms>
        <VersionSuffix></VersionSuffix>
        <!--leave empty for ci to replace with prelease tag-->
        <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">false</GeneratePackageOnBuild>
        <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Debug'">true</GeneratePackageOnBuild>
        <PackageOutputPath Condition="'$(Configuration)' == 'Debug'">..\..\Output\Activities\Packages\</PackageOutputPath>
    </PropertyGroup>

    <!--
      The extended package keeps the id of the original Database package: projects that upgrade UiPath.Database.Activities
      keep working as before. The activity code comes from the dependency UiPath.Database.Core.Activities (a project
      reference below becomes a package dependency); the extended assemblies carry the Oracle provider and, for Studio
      Web, a copy of Core's activities manifest and icons so that the package is listed and shows its activities. The
      Oracle driver ships its own cryptography instead of the operating system crypto module, so this package is not
      limited to OS crypto; new projects that need that use UiPath.Database.Core.Activities.
    -->
    <PropertyGroup>
        <PackageId>UiPath.Database.Activities</PackageId>
        <PackageTitle>UiPath.Database.Activities</PackageTitle>
        <PackageIconUrl>https://download.uipath.com/UI_icon.png?web</PackageIconUrl>
        <PackageLicenseUrl>https://github.com/UiPath/Community.Activities/tree/develop/Activities/Database/Licenses</PackageLicenseUrl>
        <PackageTags>UiPathActivities</PackageTags>
        <Description>
            <![CDATA[IMPORTANT: This package version requires Studio v24.10 or above. Installing it on versions lower than the recommended ones may cause unexpected changes in your workflows.
            UiPath Database Activities Pack. Includes UiPath.Database.Core.Activities and the Oracle provider; the Oracle driver is not limited to operating system cryptography. Use UiPath.Database.Core.Activities for operating system cryptography only, and never next to an older UiPath.Database.Activities: upgrade this package or remove it first. Keep both packages on the same version.]]>
        </Description>
        <Authors>UiPath</Authors>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);AddDlls</TargetsForTfmSpecificBuildOutput>
        <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
    </PropertyGroup>

    <Target Name="RemoveMetaDll" AfterTargets="BuiltProjectOutputGroup">
        <ItemGroup>
            <BuiltProjectOutputGroupOutput Remove="@(BuiltProjectOutputGroupOutput)" />
        </ItemGroup>
    </Target>

    <Target Name="AddDlls">
        <ItemGroup Label="AddExtendedDlls">
            <BuildOutputInPackage Include="$(OutputPath)UiPath.Database.Activities.Extended.dll" />
        </ItemGroup>

        <ItemGroup Label="AddWindowsSpecificDlls" Condition=" '$(TargetFramework)' != '$(PortableFramework)' ">
            <BuildOutputInPackage Include="$(OutputPath)UiPath.Database.Activities.Extended.Design.dll" />
        </ItemGroup>
    </Target>

    <Target Name="CleanPackageFiles" BeforeTargets="Build">
        <Message Text="Deleting packages ..." />
        <ItemGroup>
            <PackageFilesToDelete Include="$(PackageOutputPath)\$(PackageId).*.nupkg" />
        </ItemGroup>
        <Delete Files="@(PackageFilesToDelete)" ContinueOnError="WarnAndContinue" />
    </Target>

    <ItemGroup>
        <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    </ItemGroup>

    <ItemGroup>
        <!-- The assemblies that ship; their content is added by AddDlls, nothing flows from them -->
        <ProjectReference Include="..\UiPath.Database.Activities.Extended\UiPath.Database.Activities.Extended.csproj">
            <PrivateAssets>All</PrivateAssets>
        </ProjectReference>
        <!-- The core package becomes the package dependency UiPath.Database.Core.Activities -->
        <ProjectReference Include="..\UiPath.Database.Core.Activities.Packaging\UiPath.Database.Core.Activities.Packaging.csproj" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' != '$(PortableFramework)' ">
        <ProjectReference Include="..\UiPath.Database.Activities.Extended.Design\UiPath.Database.Activities.Extended.Design.csproj">
            <PrivateAssets>All</PrivateAssets>
        </ProjectReference>
    </ItemGroup>
</Project>
