<sap:WorkflowElementDialog x:Class="UiPath.Data.ConnectionUI.Dialog.Controls.SqliteConnectionUIControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sap="clr-namespace:System.Activities.Presentation;assembly=System.Activities.Presentation"
        xmlns:p="clr-namespace:UiPath.Data.ConnectionUI.Dialog.Properties"
        MinWidth="300">
    <StackPanel Margin="5">
        <Label Content="{x:Static p:Resources.FileName_Label}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Name="fileNameTextBox" HorizontalAlignment="Stretch" Margin="5,0,5,0"
                     Text="{Binding Path=DataSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="{x:Static p:Resources.BrowseButton_Label}" Click="BrowseButton_Click" />
        </Grid>
    </StackPanel>
</sap:WorkflowElementDialog>
